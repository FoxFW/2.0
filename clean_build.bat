@echo off
setlocal enabledelayedexpansion
chcp 65001 >nul




:MENU
cls
echo ===================================================
echo  MASTER COMPILATION OPERATOR AUTOMATION
echo ===================================================
echo.
echo  [F] Clean Workspace + Flash Live USB [flash_usb_full]
echo  [U] Clean Workspace + Generate TGZ ^& DFU [updater_package]
echo  [C] Run fbt -c
echo  [K] Delete Build, Dist, ^& scons.dblite
echo  [E] Delete Build, Dist, ^& scons.dblite + run fbt -c
echo  [N] Native Fast Compilation Pass Only [fbt]
echo.
echo  [M] Min-Package (DFU ONLY) [fbt updater_minpackage]
echo  [A] Exit Fox Master Compilation window to CMD
echo  [D] Exit Fox Master Compilation window and Close Window
echo.
echo ===================================================
echo.

:: Capture character keys instantly without pressing Enter
choice /c FUCKENMAD /n /m "Select your compilation route: "

if errorlevel 9 goto CMD_EXIT
if errorlevel 8 goto CMD_GOTO
if errorlevel 7 goto MINPKG
if errorlevel 6 goto JUSTFBT
if errorlevel 5 goto CLEAN_FBT
if errorlevel 4 goto JUST_CLEAN
if errorlevel 3 goto FBT_C
if errorlevel 2 goto UPDPKG
if errorlevel 1 goto LVEUSB

:LVEUSB
cls
echo ===================================================
echo 🚀 CLEANING WORKSPACE AND LAUNCHING LIVE USB FLASH...
echo ===================================================
if exist build rmdir /s /q build
if exist dist rmdir /s /q dist
if exist .sconsign.dblite del /f /q .sconsign.dblite
call fbt -c

:LOOP_LVEUSB
echo Running live USB flash...

:: Stream fbt output live, tee it to a log file for size parsing, set flag on
:: Permission/Denied, restart if Error seen after flag is set
powershell -Command "$flag=$false; $restart=$false; cmd.exe /c fbt flash_usb_full COMPACT=1 DEBUG=0 FORCE=1 2>&1 | Tee-Object -FilePath 'clean_build_output.tmp.log' | ForEach-Object { Write-Host $_; if ($_ -match '(?i)permission|(?i)denied') { $flag=$true }; if ($_ -match '(?i)error' -and $flag) { $restart=$true } }; if ($restart) { exit 0 } else { exit 1 }"
if %errorlevel%==0 (
 echo.
 echo Permission/Denied + Error detected! Retrying command...
 echo.
 goto LOOP_LVEUSB
)

call :SIZE_REPORT

echo.
powershell -NoProfile -EncodedCommand 
goto MENU

:UPDPKG
cls
echo ===================================================
echo 🚀 CLEANING WORKSPACE AND GENERATING UPDATER PACKAGE...
echo ===================================================
if exist build rmdir /s /q build
if exist dist rmdir /s /q dist
if exist .sconsign.dblite del /f /q .sconsign.dblite
call fbt -c

:LOOP_UPDPKG
echo Running updater package...

:: Stream fbt output live, tee it to a log file for size parsing, set flag on
:: Permission/Denied, restart if Error seen after flag is set
powershell -Command "$flag=$false; $restart=$false; cmd.exe /c fbt updater_package COMPACT=1 DEBUG=0 FORCE=1 2>&1 | Tee-Object -FilePath 'clean_build_output.tmp.log' | ForEach-Object { Write-Host $_; if ($_ -match '(?i)permission|(?i)denied') { $flag=$true }; if ($_ -match '(?i)error' -and $flag) { $restart=$true } }; if ($restart) { exit 0 } else { exit 1 }"
if %errorlevel%==0 (
 echo.
 echo Permission/Denied + Error detected! Retrying command...
 echo.
 goto LOOP_UPDPKG
)

call :SIZE_REPORT

echo.
powershell -NoProfile -EncodedCommand 
goto MENU

:FBT_C
cls
echo ===================================================
echo 🚀 RUNNING FBT CLEAN (-c)...
echo ===================================================
call fbt -c
echo.
powershell -NoProfile -EncodedCommand 
goto MENU

:JUST_CLEAN
cls
echo ===================================================
echo 🚀 DELETING BUILD, DIST, AND SCONS.DBLITE...
echo ===================================================
if exist build rmdir /s /q build
if exist dist rmdir /s /q dist
if exist .sconsign.dblite del /f /q .sconsign.dblite
echo Done.
echo.
powershell -NoProfile -EncodedCommand 
goto MENU

:CLEAN_FBT
cls
echo ===================================================
echo 🚀 DELETING FILES AND RUNNING FBT CLEAN...
echo ===================================================
if exist build rmdir /s /q build
if exist dist rmdir /s /q dist
if exist .sconsign.dblite del /f /q .sconsign.dblite
call fbt -c
echo.
powershell -NoProfile -EncodedCommand 
goto MENU

:JUSTFBT
cls
echo ===================================================
echo 🚀 LAUNCHING NATIVE FAST COMPILATION PASS ONLY...
echo ===================================================
powershell -Command "cmd.exe /c fbt 2>&1 | Tee-Object -FilePath 'clean_build_output.tmp.log' | ForEach-Object { Write-Host $_ }"

call :SIZE_REPORT

echo.
powershell -NoProfile -EncodedCommand 
goto MENU

:MINPKG
cls
echo ===================================================
echo 🚀 RUNNING MIN-PACKAGE (DFU ONLY)...
echo ===================================================
powershell -Command "cmd.exe /c fbt updater_minpackage 2>&1 | Tee-Object -FilePath 'clean_build_output.tmp.log' | ForEach-Object { Write-Host $_ }"

call :SIZE_REPORT

echo.
powershell -NoProfile -EncodedCommand 
goto MENU

:CMD_GOTO
cls
echo 📄 Opening command prompt in this folder...
echo.
start cmd /k
exit

:CMD_EXIT
cls
echo 📄 Closing operator console window...
exit

:: =====================================================================
:: SIZE_REPORT - firmware size comparison report
:: Called after any option that actually compiles firmware: F (LVEUSB),
:: U (UPDPKG), N (JUSTFBT), M (MINPKG). Clean-only options (C/K/E) do not
:: call it since they never produce a "Firmware size" section.
::
:: Everything needed lives in this single .bat file: the block below
:: rebuilds a small PowerShell helper from an embedded Base64 blob,
:: decodes it to a throwaway temp script, runs it, then deletes it.
:: The helper parses clean_build_output.tmp.log (written by the fbt
:: run above) for the "Firmware size" section. fbt can print this
:: section twice in one compile - the real firmware block (which has a
:: .free_flash line) and a second, later block that has no .free_flash
:: line. The helper uses the presence of .free_flash as the marker to
:: pick the correct block, falling back to the first complete block
:: found if no block has that marker.
:: Free flash space is computed as (0x080D7000 minus flash base
:: 0x08000000) minus (.text+.rodata+.data) - .bss is RAM only and is
:: excluded from the flash-used/free-space math (shown separately, for
:: information). The "Flash Used" row is not printed (it is just the
:: sum of .text/.rodata/.data, shown individually already); Free Space
:: is shown after its own "====" divider, on its own at the end, since
:: it is the number that matters most. Every value is shown as raw
:: bytes with thousands separators plus the KB equivalent in parens,
:: e.g. "880,640 bytes (860.00 Kb)". clean_build.txt is rewritten with
:: the latest values each run; no other file is created or left behind.
:: =====================================================================
:SIZE_REPORT
if exist "%TEMP%\cbsr.b64" del /f /q "%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
echo >>"%TEMP%\cbsr.b64"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$bp=Join-Path $env:TEMP 'cbsr.b64'; $b=(Get-Content -LiteralPath $bp) -join ''; $bytes=[Convert]::FromBase64String($b); $s=[System.Text.Encoding]::Unicode.GetString($bytes); $t=Join-Path $env:TEMP ('cbsr_' + [guid]::NewGuid().ToString('N') + '.ps1'); Set-Content -LiteralPath $t -Value $s -Encoding UTF8; & $t; Remove-Item -LiteralPath $t -Force -ErrorAction SilentlyContinue"
if exist "%TEMP%\cbsr.b64" del /f /q "%TEMP%\cbsr.b64"
if exist clean_build_output.tmp.log del /f /q clean_build_output.tmp.log
exit /b
