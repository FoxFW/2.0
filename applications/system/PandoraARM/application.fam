App(
    appid="pandora_arm",
    name="Pandora ARM",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="pandora_arm_app",
    sources=["*.c*", "!lib", "!tests", "!hosttest"],
    requires=["gui", "dialogs", "storage"],
    stack_size=8 * 1024,
    fap_private_libs=[
        Lib(
            # Thumb-2 (Cortex-M3) interpreter as a private lib, built -Os: the
            # FAP loads into the Flipper heap, so code size matters more here
            # than the speed of the per-instruction loop.
            name="thumbcore",
            cflags=["-Os"],
        ),
    ],
    fap_category="Sub-GHz",
    fap_file_assets="resources",
    fap_icon="icon.png",
    fap_author="user",
    fap_version="0.1",
    fap_description="Emulates the real Pandora D-605 keyfob firmware (EFM32 Cortex-M3). Loads the .hex/.bin from SD, shows the keyfob OLED, knock-code unlock, and uses the Flipper CC1101 for real RF RX/TX.",
)
