# For details & more options, see documentation/AppManifests.md in firmware repo

App(
    appid="fmps_cxt",  # Must be unique
    name="Proxmark5",  # Displayed in menus
    apptype=FlipperAppType.EXTERNAL,
    entry_point="fmps_cxt_app", # FlipperZero Master/ Proxmark5 Slave, TypeC Extend Transport.
    stack_size=2 * 1024,
    fap_category="rfid",
    # Optional values
    fap_version="0.1",
    fap_icon="images/fmps_cxt.png",  # 10x10 1-bit PNG
    fap_description="Operate your PM5 on F0",
    fap_author="DXL",
    fap_weburl="https://github.com/RfidResearchGroup/Proxmark5_FlipperZero_FAP",
    fap_icon_assets="images",  # Image assets to compile for this application
    # list of additional libraries distributed as sources alongside the app
    fap_private_libs=[
        # The proxmark5 driver library
        Lib(
            name="proxmark5_driver",
            fap_include_paths=["."],
            sources=[
                "proxmark5_uart.c",
                "proxmark5_spi.c",
                "proxmark5_com.c",
                "proxmark5_frame.c",
            ],
        ),
    ],
)
