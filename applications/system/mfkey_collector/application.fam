App(
    appid="mfkey_collector",
    name="MFKey Nonce Collector",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="mfkey_collector_app",
    # FoxFW: externalized "Extract MFC Keys" (Mfkey32 reader-attack) nonce
    # collection, moved out of nfc.fap to cut its resident RAM footprint. nfc.fap
    # launches this via the loader; standalone launch emulates a fresh random
    # MIFARE Classic 4K card. Uses the firmware's NFC engine + MfClassic listener
    # (both in the firmware API), so no protocol code is bundled here.
    icon="A_NFC_14",
    stack_size=8 * 1024,
    order=20,
    fap_category="NFC",
    fap_libs=["assets"],
    fap_icon="icon.png",
    fap_icon_assets="icons",
    fap_description="Collect MIFARE Classic reader nonces (Mfkey32) for key extraction",
    fap_version=(1, 0),
)
