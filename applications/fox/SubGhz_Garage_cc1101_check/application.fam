App(
    appid="subghz_garage_cc1101_check",
    name="Sub-GHz: Garage/Gate/Other",
    apptype=FlipperAppType.EXTERNAL,
    icon="I_fox_generic_14x14",  # 14x14 Apps-menu icon; see assets/icons/Fox/fox_generic_14x14.png
    entry_point="subghz_garage_cc1101_check_app",
    # Same reasoning as subghz_garage's own stack_size bump: this app loads
    # an external .fal radio-device plugin at runtime (PluginManager/ELF
    # relocation), which has deeper/more stack-hungry call chains than a
    # normal statically-linked app - 1-2KB was marginal for that exact
    # code path when it was tried in Garage.
    stack_size=6 * 1024,
    fap_icon="icon.png",
    fap_category="Sub-GHz",
    fap_description="Sub-GHz: Garage/Gate/Other, with a fresh external-CC1101 module check run first and cached to /ext/subghz/.cc1101_ext_status - this is the entry most users want. Checks for an external module (GPIO/external antenna), then opens the real Garage/Gate/Other app (appid subghz_garage, listed separately as \"Garage/Gate/Other (Direct)\") either way. Also run automatically in the background by Desktop, and by the Sub-GHz Mode Picker every time Garage/Gate/Other is opened from there.",
    fap_version="1.0",
)
