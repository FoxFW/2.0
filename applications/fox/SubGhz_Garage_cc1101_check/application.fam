App(
    appid="subghz_garage_cc1101_check",
    name="CC1101 External Probe for SubGhz Garage",
    apptype=FlipperAppType.EXTERNAL,
    icon="I_fox_generic_14x14",  # 14x14 Apps-menu icon; see assets/icons/Fox/fox_generic_14x14.png
    entry_point="subghz_garage_cc1101_check_app",
    # Same reasoning as subghz_garage's own stack_size bump: this app loads
    # an external .fal radio-device plugin at runtime (PluginManager/ELF
    # relocation), which has deeper/more stack-hungry call chains than a
    # normal statically-linked app - 1-2KB was marginal for that exact
    # code path when it was tried in Garage.
    stack_size=6 * 1024,
    fap_icon="icon.png",
    fap_category="Sub-GHz",
    fap_description="Background helper: checks for an external CC1101 module (GPIO/external antenna) and caches the result to /ext/subghz/.cc1101_ext_status for Sub-GHz apps that don't want to pay the ~25KB external-plugin-load RAM cost themselves just to find out nothing's plugged in. Launched automatically in the background by Desktop periodically and by the Sub-Ghz Mode picker every time Garage/Gate/Other is opened - running it manually from the Apps menu forces an immediate recheck and then opens Garage/Gate/Other.",
    fap_version="1.0",
)
