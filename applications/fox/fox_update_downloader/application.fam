App(
    appid="fox_update_downloader",
    name="Fox Update Downloader",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="fox_update_downloader_main",
    requires=[
        "gui",
        "storage",
        "dialogs",
        "loader",
    ],
    stack_size=8 * 1024,
    fap_category="Fox/ESP32",
