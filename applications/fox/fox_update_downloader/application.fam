    order=30,
    fap_author="FoxFW",
    fap_icon="icon.png",
    fap_icon_assets="images",
    fap_description="Fox Update Downloader - checks GitHub for newer FoxFW2.0 and Fox ESP32 Firmware releases, downloads them over the ESP32 bridge, and hands off to install",
)
