App(
    appid="csight",
    name="CSIght (Fox Edition)",
    apptype=FlipperAppType.EXTERNAL,
    # 14x14 home-screen Apps-menu icon. Inert for an EXTERNAL app today -
    # only a MENUEXTERNAL app's FLIPPER_EXTERNAL_APPS entry actually reads
    # this field - but set on every Fox app now so none of them shows the
    # generic fallback icon if it's ever added to that menu. See
    # assets/icons/Fox/fox_generic_14x14.png.
    icon="I_fox_generic_14x14",
    entry_point="csight_app",
    requires=[
        "gui",
        "storage",
        "notification",
        "expansion",
    ],
    stack_size=4 * 1024,
    fap_icon="images/csight_icon_10x10.png",
    fap_category="Fox/ESP32",
    fap_description="WiFi CSI radar — motion/vitals/mesh sensing via Fox_ESP32_FW",
    fap_author="CSIght (ported to Fox protocol)",
    fap_version="3.3",
    sources=[
        "csight_app.c",
        "csight_draw.c",
        "csight_uart.c",
        "csight_log.c",
        "wifi/esp_at.c",
    ],
)
