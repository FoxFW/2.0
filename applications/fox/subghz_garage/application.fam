App(
    appid="subghz_garage",
    name="Sub-GHz: Garage/Gate/Other",
    apptype=FlipperAppType.EXTERNAL,
    # 14x14 home-screen Apps-menu icon; only the main app gets this (the
    # ~50 PLUGIN entries below are protocol/CC1101 plugins, never listed
    # in that menu themselves). See assets/icons/Fox/fox_generic_14x14.png.
    icon="I_fox_generic_14x14",
    targets=["f7"],
    entry_point="subghz_app",
    requires=[
        "gui",
        "dialogs",
    ],
    # 3KB (inherited from the Automotive fork, which never exercises the
    # PluginManager/ELF loader since it's compiled directly into firmware)
    # was marginal here: this app loads external .fal plugins at runtime
    # (external CC1101 device, protocol group plugins), and that machinery
    # has deeper/more stack-hungry call chains than a normal statically-
    # linked app ever hits. General heap has 130KB+ free at idle, so this
    # is cheap - raised to give real headroom against a stack overflow.
    stack_size=6 * 1024,
    resources="resources",
    # Only meaningful on FoxFW2.0's own build - gates the lazy split of
    # subghz_devices_init() this firmware adds for the CC1101 external-
    # probe feature (see helpers/subghz_devices_lazy_compat.h). Stripped
    # for the subghz_garage_COMPATIBLE cross-fork variant by
    # sync_apps_from_foxfw.ps1, since no other fork has that split API.
    # SUBGHZ_GARAGE_HAS_LIB_EXTENSIONS gates several small FoxFW2.0-only
    # additions to shared lib/subghz + furi_hal_subghz headers (KeeLoq
    # reset, default-frequency marking, Counter BruteForce's rolling-
    # counter/override hooks, Decode RAW's live progress text, external-
    # module LED/amp GPIO control) - see helpers/subghz_lib_ext_compat.h.
    # SUBGHZ_GARAGE_HAS_CUSTOM_BTN gates the custom-button-remap system
    # (lib/subghz/blocks/custom_btn.h/.c, custom_btn_i.h) - see helpers/
    # subghz_custom_btn_compat.h. SUBGHZ_GARAGE_HAS_CLI_VCP_LOCK gates
    # cli_vcp_session_lock()/_unlock() (applications/services/cli/
    # cli_vcp.h) - see helpers/subghz_cli_vcp_compat.h.
    # SUBGHZ_GARAGE_HAS_MEMMGR_POOL_STATS gates memmgr_pool_get_free()/
    # _get_max_block() (furi/core/memmgr.h) - declared on every fork, but
    # their implementations are disabled in ARF/Unleashed/Momentum/Stock's
    # compiled firmware, which fails the cross-fork SDK's symbol-resolution
    # check even though the app compiles cleanly - see helpers/
    # subghz_memmgr_pool_compat.h. Those five are all stripped uniformly
    # for the _COMPATIBLE cross-fork variant.
    # SUBGHZ_GARAGE_HAS_GENERIC_GLOBAL gates SubGhzBlockGenericGlobal
    # (lib/subghz/blocks/generic.h) - see helpers/
    # subghz_generic_global_compat.h. SUBGHZ_GARAGE_HAS_NAME_GEN_DATETIME
    # gates name_generator_make_auto_datetime() (lib/toolbox/
    # name_generator.h) - see helpers/subghz_name_generator_compat.h.
    # SUBGHZ_GARAGE_HAS_ITEM_LOCK gates variable_item_set_locked()
    # (applications/services/gui/modules/variable_item_list.h) - see
    # helpers/subghz_variable_item_lock_compat.h. SUBGHZ_GARAGE_HAS_BINRAW_TYPE
    # gates SubGhzProtocolTypeBinRAW (lib/subghz/types.h) - see helpers/
    # subghz_binraw_type_compat.h. SUBGHZ_GARAGE_HAS_RECEIVER_ICONS gates
    # whether views/receiver.c relies on assets_icons.h for the Static/
    # Dynamic/Raw/Cos_9x7 icons (present) or re-declares+bundles them itself
    # (absent) - see icons_receiver/. SUBGHZ_GARAGE_HAS_FONT_BATTERY_PERCENT
    # gates FontBatteryPercent (applications/services/gui/canvas.h) in
    # views/transmitter.c (falls back to FontSecondary).
    # SUBGHZ_GARAGE_HAS_TX_ALLOWED_CHECK gates furi_hal_subghz_is_tx_allowed()
    # (targets/f7/furi_hal/furi_hal_subghz.h) in subghz_last_settings.c/
    # subghz_i.c - see helpers/subghz_tx_allowed_compat.h. None of these
    # seven is stripped uniformly: ARF/Unleashed/Momentum each carry the
    # same additions in their own lib/subghz + lib/toolbox + gui modules +
    # assets/icons + furi_hal_subghz, so they're set per-fork by
    # build_all_firmwares.ps1/build_changed_apps.ps1 instead - present for
    # those three, stripped only for Stock.
    #
    # SUBGHZ_GARAGE_HAS_GENERIC_DATA2_SEED (same per-fork shape, see
    # helpers/subghz_generic_data2_seed_compat.h) gates data_2/seed on
    # SubGhzBlockGeneric (lib/subghz/blocks/generic.h) - not added to this
    # main-app cdefines list since none of these files are main-app
    # sources; it's added directly to the individual protocol-group and
    # TX-plugin App() blocks below that actually compile Jarolift, Nice
    # FlorS, FAAC SLH, Alutech AT-4N, BENINCA ARC, CAME Atomo, KingGates
    # Stylo4K, or Somfy Keytis.
    cdefines=[
        "SUBGHZ_GARAGE_HAS_DEVICES_LAZY_INIT=1",
        "SUBGHZ_GARAGE_HAS_LIB_EXTENSIONS=1",
        "SUBGHZ_GARAGE_HAS_CUSTOM_BTN=1",
        "SUBGHZ_GARAGE_HAS_CLI_VCP_LOCK=1",
        "SUBGHZ_GARAGE_HAS_MEMMGR_POOL_STATS=1",
        "SUBGHZ_GARAGE_HAS_GENERIC_GLOBAL=1",
        "SUBGHZ_GARAGE_HAS_BINRAW_TYPE=1",
        "SUBGHZ_GARAGE_HAS_RECEIVER_ICONS=1",
        "SUBGHZ_GARAGE_HAS_FONT_BATTERY_PERCENT=1",
        "SUBGHZ_GARAGE_HAS_NAME_GEN_DATETIME=1",
        "SUBGHZ_GARAGE_HAS_ITEM_LOCK=1",
        "SUBGHZ_GARAGE_HAS_TX_ALLOWED_CHECK=1",
    ],
    sources=[
        "*.c*",
        "!subghz_cli.c",
        "!subghz_dangerous_freq.c",
        "!helpers/subghz_chat.c",
        "!protocols",
        "protocols/protocol_groups.c",
        # Automotive-only KeeLoq manufacturer-key bruteforce/decrypt toolchain
        # and PSA Decrypt - not needed for garage/gate use. Source still on
        # disk (not deletable from here) but excluded from compilation; a
        # copy is staged in D:\_to_delete for reference.
        "!scenes/subghz_scene_psa_decrypt.c",
        "!scenes/subghz_scene_keeloq_bf2.c",
        "!scenes/subghz_scene_keeloq_decrypt.c",
        "!scenes/subghz_scene_kl_bf_cleanup.c",
        "!scenes/subghz_scene_keeloq_keys.c",
        "!scenes/subghz_scene_keeloq_key_edit.c",
        "!helpers/subghz_keeloq_keys.c",
        "!views/subghz_psa_decrypt.c",
        "!views/subghz_keeloq_decrypt.c",
        # "Add Manually" removed entirely - manual key/serial/counter/seed
        # entry across ~50 protocol variants wasn't worth its own code size
        # in a stripped-down garage/gate tool. Source still on disk (not
        # deletable from here) but excluded from compilation, same as the
        # Automotive-only files above.
        "!scenes/subghz_scene_set_type.c",
        "!scenes/subghz_scene_set_key.c",
        "!scenes/subghz_scene_set_serial.c",
        "!scenes/subghz_scene_set_seed.c",
        "!scenes/subghz_scene_set_counter.c",
        "!scenes/subghz_scene_set_button.c",
        # Also dead: nothing ever navigated to this scene even before Add
        # Manually was removed (no scene_manager_next_scene call anywhere
        # targeted it).
        "!scenes/subghz_scene_custom_freq.c",
        "!helpers/subghz_gen_info.c",
        "!helpers/subghz_txrx_create_protocol_key.c",
        # Radio Settings scene removal (shared with Automotive via the Mode
        # Picker) left this empty stray file behind - can't be deleted from
        # here, excluded so it's never compiled either way.
        "!scenes/subghz_scene_radio_settings.c.bak",
        # "Modulations" screen removed from the Start page - manual per-
        # preset enable/disable was redundant with Protocol Group selection
        # once decoders were confirmed not to be modulation-gated. Its
        # ADD_SCENE entry is gone from scenes/subghz_scene_config.h, so this
        # file no longer compiles (references the now-undefined
        # SubGhzSceneModulationList) - can't be deleted from here, excluded.
        # Please delete this file, along with two now-superseded settings
        # resources - resources/subghz/assets/setting_garage (replaced by
        # setting_garage_full) and resources/subghz/assets/setting_garage_boot
        # (a boot/full settings split was tried and reverted - see the
        # comment in helpers/subghz_txrx.c's subghz_txrx_alloc() - so this
        # one was never actually shipped in a release, just leftover from
        # mid-session) - next time you're in here.
        "!scenes/subghz_scene_modulation_list.c",
    ],
    fap_libs=["assets", "hwdrivers"],
    fap_icon="icon.png",
    fap_category="Sub-GHz",
    fap_description="Sub-GHz - garage, gate, and other non-automotive protocols",
    fap_version="1.0",
)

# The 40 non-automotive protocols (plus Read RAW's raw/bin_raw, duplicated
# in every group) are split into 11 plugins instead of one. Flipper maps an
# external app's whole binary into RAM to run it, and one combined plugin
# couldn't be resident in RAM1 alongside the main .fap ("Not enough memory
# to load section data"). Groups are organized by manufacturer/region/
# device-type, capped at 4 protocols each - see
# subghz_garage_protocol_group_names in protocol_groups.c for what's in
# each one. Only one group is ever loaded at a time - see
# subghz_txrx_ensure_protocol_group in helpers/subghz_txrx.c.
App(
    appid="subghz_garage_protocols_g1",
    apptype=FlipperAppType.PLUGIN,
    entry_point="subghz_garage_protocol_plugin_g1_ep",
    requires=["subghz_garage"],
    cdefines=["SUBGHZ_GARAGE_RX_ONLY=1", "SUBGHZ_GARAGE_HAS_GENERIC_GLOBAL=1", "SUBGHZ_GARAGE_HAS_BINRAW_TYPE=1"],
    sources=[
        "protocols/plugins/subghz_garage_protocol_plugin_g1.c",
        "protocols/protocols_common.c",
        "protocols/raw.c",
        "protocols/bin_raw.c",
        "protocols/smc5326.c",
        "protocols/holtek.c",
        "protocols/holtek_ht12x.c",
        "protocols/princeton.c",
    ],
    fal_embedded=True,
)

