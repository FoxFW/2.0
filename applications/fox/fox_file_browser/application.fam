App(
    appid="ffb",
    name="Fox File Browser",
    apptype=FlipperAppType.EXTERNAL,
    icon="I_fox_generic_14x14",  # 14x14 Apps-menu icon; see assets/icons/Fox/fox_generic_14x14.png
    entry_point="ffb_app",
    requires=[
        "gui",
        "storage",
        "dialogs",
    ],
    stack_size=3 * 1024,
    fap_category="Fox",
    fap_version="1.0",
    fap_description="Browse files and install firmware updates",
    fap_author="FoxFW Team",
    fap_icon="icon.png",
    fap_icon_assets="images",
    sources=["*.c*"],
)
