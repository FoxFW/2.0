@echo off
setlocal enabledelayedexpansion
chcp 65001 >nul

cd /d "%~dp0.."

:MENU
echo.
echo ===================================================
echo  FBT SHORTCUT MENU
echo ===================================================
echo.
echo  [1] Clean Workspace + Generate TGZ ^& DFU [updater_package]
echo  [2] Clean Workspace + Flash Live USB [flash_usb_full]
echo  [3] Native Fast Compilation Pass Only [fbt]
echo  [4] Min-Package (DFU ONLY) [fbt updater_minpackage]
echo  [5] Run fbt -c
echo  [6] Delete Build, Dist, ^& scons.dblite
echo  [7] Delete Build, Dist, ^& scons.dblite + run fbt -c
echo.
echo  [8] Exit FBT Shortcut Menu
echo.
echo ===================================================
echo.

:: Capture character keys instantly without pressing Enter
choice /c 12345678 /n /m "Enter Selection: "
echo.

if errorlevel 8 goto CMD_EXIT
if errorlevel 7 goto CLEAN_FBT
if errorlevel 6 goto JUST_CLEAN
if errorlevel 5 goto FBT_C
if errorlevel 4 goto MINPKG
if errorlevel 3 goto JUSTFBT
if errorlevel 2 goto LVEUSB
if errorlevel 1 goto UPDPKG

:LVEUSB
echo ===================================================
echo CLEANING WORKSPACE AND LAUNCHING LIVE USB FLASH...
echo ===================================================
if exist build rmdir /s /q build
if exist dist rmdir /s /q dist
if exist .sconsign.dblite del /f /q .sconsign.dblite
call fbt -c

:LOOP_LVEUSB
echo Running live USB flash...

:: Stream fbt output live, tee it to a log file for size parsing, set flag on
:: Permission/Denied, restart if Error seen after flag is set
powershell -Command "$flag=$false; $restart=$false; cmd.exe /c fbt flash_usb_full COMPACT=1 DEBUG=0 FORCE=1 2>&1 | Tee-Object -FilePath 'fbt_build_output.tmp.log' | ForEach-Object { Write-Host $_; if ($_ -match '(?i)permission|(?i)denied') { $flag=$true }; if ($_ -match '(?i)error' -and $flag) { $restart=$true } }; if ($restart) { exit 0 } else { exit 1 }"
if %errorlevel%==0 (
 echo.
 echo Permission/Denied + Error detected! Retrying command...
 echo.
 goto LOOP_LVEUSB
)

call :SIZE_REPORT

echo.
:LOOP_LVEUSB_WAITENTER
if defined RETRY_LOOP_LVEUSB (
    powershell -NoProfile -EncodedCommand 
) else (
    powershell -NoProfile -EncodedCommand 
)
if not "%errorlevel%"=="0" (
    set "RETRY_LOOP_LVEUSB=1"
    goto LOOP_LVEUSB_WAITENTER
)
set "RETRY_LOOP_LVEUSB="
goto MENU

:UPDPKG
echo ===================================================
echo CLEANING WORKSPACE AND GENERATING UPDATER PACKAGE...
echo ===================================================
if exist build rmdir /s /q build
if exist dist rmdir /s /q dist
if exist .sconsign.dblite del /f /q .sconsign.dblite
call fbt -c

:LOOP_UPDPKG
echo Running updater package...

:: Stream fbt output live, tee it to a log file for size parsing, set flag on
:: Permission/Denied, restart if Error seen after flag is set
powershell -Command "$flag=$false; $restart=$false; cmd.exe /c fbt updater_package COMPACT=1 DEBUG=0 FORCE=1 2>&1 | Tee-Object -FilePath 'fbt_build_output.tmp.log' | ForEach-Object { Write-Host $_; if ($_ -match '(?i)permission|(?i)denied') { $flag=$true }; if ($_ -match '(?i)error' -and $flag) { $restart=$true } }; if ($restart) { exit 0 } else { exit 1 }"
if %errorlevel%==0 (
 echo.
 echo Permission/Denied + Error detected! Retrying command...
 echo.
 goto LOOP_UPDPKG
)

call :SIZE_REPORT

echo.
:LOOP_UPDPKG_WAITENTER
if defined RETRY_LOOP_UPDPKG (
    powershell -NoProfile -EncodedCommand 
) else (
    powershell -NoProfile -EncodedCommand 
)
if not "%errorlevel%"=="0" (
    set "RETRY_LOOP_UPDPKG=1"
    goto LOOP_UPDPKG_WAITENTER
)
set "RETRY_LOOP_UPDPKG="
goto MENU

:FBT_C
echo ===================================================
echo RUNNING FBT CLEAN (-c)...
echo ===================================================
call fbt -c
echo.
:FBT_C_WAITENTER
if defined RETRY_FBT_C (
    powershell -NoProfile -EncodedCommand 
) else (
    powershell -NoProfile -EncodedCommand 
)
if not "%errorlevel%"=="0" (
    set "RETRY_FBT_C=1"
    goto FBT_C_WAITENTER
)
set "RETRY_FBT_C="
goto MENU

:JUST_CLEAN
echo ===================================================
echo DELETING BUILD, DIST, AND SCONS.DBLITE...
echo ===================================================
if exist build rmdir /s /q build
if exist dist rmdir /s /q dist
if exist .sconsign.dblite del /f /q .sconsign.dblite
echo Done.
echo.
:JUST_CLEAN_WAITENTER
if defined RETRY_JUST_CLEAN (
    powershell -NoProfile -EncodedCommand 
) else (
    powershell -NoProfile -EncodedCommand 
)
if not "%errorlevel%"=="0" (
    set "RETRY_JUST_CLEAN=1"
    goto JUST_CLEAN_WAITENTER
)
set "RETRY_JUST_CLEAN="
goto MENU

:CLEAN_FBT
echo ===================================================
echo DELETING FILES AND RUNNING FBT CLEAN...
echo ===================================================
if exist build rmdir /s /q build
if exist dist rmdir /s /q dist
if exist .sconsign.dblite del /f /q .sconsign.dblite
call fbt -c
echo.
:CLEAN_FBT_WAITENTER
if defined RETRY_CLEAN_FBT (
    powershell -NoProfile -EncodedCommand 
) else (
    powershell -NoProfile -EncodedCommand 
)
if not "%errorlevel%"=="0" (
    set "RETRY_CLEAN_FBT=1"
    goto CLEAN_FBT_WAITENTER
)
set "RETRY_CLEAN_FBT="
goto MENU

:JUSTFBT
echo ===================================================
echo LAUNCHING NATIVE FAST COMPILATION PASS ONLY...
echo ===================================================
powershell -Command "cmd.exe /c fbt 2>&1 | Tee-Object -FilePath 'fbt_build_output.tmp.log' | ForEach-Object { Write-Host $_ }"

call :SIZE_REPORT

echo.
:JUSTFBT_WAITENTER
if defined RETRY_JUSTFBT (
    powershell -NoProfile -EncodedCommand 
) else (
    powershell -NoProfile -EncodedCommand 
)
if not "%errorlevel%"=="0" (
    set "RETRY_JUSTFBT=1"
    goto JUSTFBT_WAITENTER
)
set "RETRY_JUSTFBT="
goto MENU

:MINPKG
echo ===================================================
echo RUNNING MIN-PACKAGE (DFU ONLY)...
echo ===================================================
powershell -Command "cmd.exe /c fbt updater_minpackage 2>&1 | Tee-Object -FilePath 'fbt_build_output.tmp.log' | ForEach-Object { Write-Host $_ }"

call :SIZE_REPORT

echo.
:MINPKG_WAITENTER
if defined RETRY_MINPKG (
    powershell -NoProfile -EncodedCommand 
) else (
    powershell -NoProfile -EncodedCommand 
)
if not "%errorlevel%"=="0" (
    set "RETRY_MINPKG=1"
    goto MINPKG_WAITENTER
)
set "RETRY_MINPKG="
goto MENU

:CMD_EXIT
echo Exiting...
exit /b

:: =====================================================================
:: SIZE_REPORT - firmware size comparison report
:: Called after any option that actually compiles firmware: F (LVEUSB),
:: U (UPDPKG), N (JUSTFBT), M (MINPKG). Clean-only options (C/K/E) do not
:: call it since they never produce a "Firmware size" section.
::
:: Everything needed lives in this single .bat file: the block below
:: rebuilds a small PowerShell helper from an embedded Base64 blob,
:: decodes it to a throwaway temp script, runs it, then deletes it.
:: The helper parses fbt_build_output.tmp.log (written by the fbt
:: run above) for the "Firmware size" section. fbt can print this
:: section twice in one compile - the real firmware block (which has a
:: .free_flash line) and a second, later block that has no .free_flash
:: line. The helper uses the presence of .free_flash as the marker to
:: pick the correct block, falling back to the first complete block
:: found if no block has that marker.
:: Free flash space is computed as (0x080D7000 minus flash base
:: 0x08000000) minus (.text+.rodata+.data) - .bss is RAM only and is
:: excluded from the flash-used/free-space math (shown separately, for
:: information). The "Flash Used" row is not printed (it is just the
:: sum of .text/.rodata/.data, shown individually already); Free Space
:: is shown after its own "====" divider, on its own at the end, since
:: it is the number that matters most. Every value is shown as raw
:: bytes with thousands separators plus the KB equivalent in parens,
:: e.g. "880,640 bytes (860.00 Kb)". fbt_build_size.txt is rewritten with
:: the latest values each run; no other file is created or left behind.
:: =====================================================================
